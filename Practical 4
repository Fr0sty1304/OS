#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

sem_t fork_sem[5], room;

void *philosopher(void *arg)
{
    int id = *(int *)arg;
    int left = id;
    int right = (id + 1) % 5;

    sem_wait(&room);
    sem_wait(&fork_sem[left]);
    sem_wait(&fork_sem[right]);

    printf("Philosopher %d is eating\n", id);

    sleep(1);

    sem_post(&fork_sem[right]);
    sem_post(&fork_sem[left]);
    sem_post(&room);

    return NULL;
}

int main()
{
    pthread_t t[5];
    int id[5];

    sem_init(&room, 0, 4);

    for (int i = 0; i < 5; i++)
    {
        sem_init(&fork_sem[i], 0, 1);
        id[i] = i;
    }

    for (int i = 0; i < 5; i++)
        pthread_create(&t[i], NULL, philosopher, &id[i]);

    for (int i = 0; i < 5; i++)
        pthread_join(t[i], NULL);

    return 0;
}

