#include <stdio.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd1, fd2, i = 0;
    char buf1[200], buf2[200], ch;

    mkfifo("fifo1", 0666);
    mkfifo("fifo2", 0666);

    printf("Enter sentences (# to stop):\n");

    while ((ch = getchar()) != '#' && i < 198)
        buf1[i++] = ch;

    buf1[i++] = '#';

    fd1 = open("fifo1", O_WRONLY);
    write(fd1, buf1, i);
    close(fd1);

    fd2 = open("fifo2", O_RDONLY);
    read(fd2, buf2, sizeof(buf2) - 1);
    close(fd2);

    printf("\nResult:\n%s", buf2);

    return 0;
}
