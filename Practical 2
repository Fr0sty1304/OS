#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    int a[10], n, pid, i, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    pid = fork();

    if (pid == 0)
    {
        for (i = 0; i < n; i++)
            for (j = 0; j < n - 1; j++)
                if (a[j] > a[j + 1])
                {
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }

        printf("Child ascending: ");
        for (i = 0; i < n; i++)
            printf("%d ", a[i]);
        printf("\n");
    }
    else if (pid > 0)
    {
        for (i = 0; i < n; i++)
            for (j = 0; j < n - 1; j++)
                if (a[j] < a[j + 1])
                {
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }

        printf("Parent descending: ");
        for (i = 0; i < n; i++)
            printf("%d ", a[i]);
        printf("\n");

        wait(NULL);
    }

    return 0;
}

