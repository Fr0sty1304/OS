#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd1, fd2, i, n;
    char buf1[200], buf2[200] = {0};
    int words = 0, characters = 0, lines = 0;
    int inword = 0;

    fd1 = open("fifo1", O_RDONLY);
    n = read(fd1, buf1, sizeof(buf1) - 1);
    close(fd1);
    buf1[n] = '\0';

    for (i = 0; buf1[i] != '#'; i++)
    {
        characters++;

        if (buf1[i] == '\n')
            lines++;

        if (buf1[i] == ' ' || buf1[i] == '\n' || buf1[i] == '\t')
            inword = 0;
        else if (inword == 0)
        {
            words++;
            inword = 1;
        }
    }

    if (characters > 0 && buf1[i - 1] != '\n')
        lines++;

    FILE *fp = fopen("output.txt", "w");
    fprintf(fp, "Words = %d\nCharacters = %d\nLines = %d\n",
            words, characters, lines);
    fclose(fp);

    fp = fopen("output.txt", "r");
    n = fread(buf2, 1, sizeof(buf2) - 1, fp);
    buf2[n] = '\0';
    fclose(fp);

    fd2 = open("fifo2", O_WRONLY);
    write(fd2, buf2, n + 1);
    close(fd2);

    return 0;
}

