#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <fcntl.h>
#include <string.h>

int main()
{
    int p1[2], p2[2], pid, fd, n;
    char filename[100], buffer[200];

    pipe(p1);
    pipe(p2);

    pid = fork();

    if (pid > 0)
    {
        close(p1[0]);
        close(p2[1]);

        printf("Enter filename: ");
        scanf("%99s", filename);

        write(p1[1], filename, strlen(filename) + 1);
        close(p1[1]);

        while ((n = read(p2[0], buffer, sizeof(buffer))) > 0)
            write(1, buffer, n);

        close(p2[0]);
        wait(NULL);
    }
    else if (pid == 0)
    {
        close(p1[1]);
        close(p2[0]);

        read(p1[0], filename, sizeof(filename));
        close(p1[0]);

        fd = open(filename, O_RDONLY);

        if (fd >= 0)
        {
            while ((n = read(fd, buffer, sizeof(buffer))) > 0)
                write(p2[1], buffer, n);
            close(fd);
        }

        close(p2[1]);
    }

    return 0;
}

